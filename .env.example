# Server-side only. Never expose these values to the client bundle.
# RouterAI is OpenAI-compatible: POST {BASE_URL}/chat/completions
ROUTERAI_API_KEY=
ROUTERAI_BASE_URL=https://routerai.ru/api/v1
ROUTERAI_MODEL=deepseek/deepseek-v4.1-flash-1017

# Optional: limit requests per IP per hour (default 20).
COMPOSE_RATE_LIMIT_PER_HOUR=20
